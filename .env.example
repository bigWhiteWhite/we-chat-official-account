# 复制为 .env 后填写。真实密钥只存本地 .env（已 gitignore），严禁提交。
# 模型与业务配置也可在前端 /settings 页维护（存 AppSetting 表），优先级高于本文件。

# ===== 业务 =====
APPID=
APPSECRET=
AUTHOR=
COMICS_DIR=./comics
INBOX_DIR=./inbox
TOPIC_SOURCES=self-made
PANELS_MAX_PER_CHAPTER=40
STYLE_PRESET=简约线条+低饱和色块+扁平卡通
# 生图时是否将旁白文字渲染进画面（true=竖版/横版均渲染；false=不渲染，旁白仅作图下说明发布）
NARRATION_IN_IMAGE=false
DAILY_BUDGET_CNY=10
MAX_IMAGE_PER_TASK=12
IMAGE_GEN_CONCURRENCY=2
DB_FILE=./data/comics.db

# ===== 模型域主模型（每个域只有一个模型；未配置或不可解析时该域调用直接报中文错误）=====
# 写裸 modelId 即可，绑定该域端点；跨域借端点才写 域/modelId（域：main / mainLight / vision / imageApi）
MODEL_MAIN_PRIMARY=
MODEL_MAIN_LIGHT_PRIMARY=
MODEL_VISION_PRIMARY=
MODEL_IMAGE_API_PRIMARY=
# 多候选降级开关：当前每域只有一个主模型，无候选可切，此项暂无实际效果（代码能力保留）
MODEL_AUTO_FALLBACK=true

# ===== 端点（接任意 OpenAI 兼容端点都不改代码：官方 / NewAPI / OneAPI / vLLM / SGLang 等）=====
# 全局兜底 MODEL_BASE_URL / MODEL_API_KEY 供所有域共用；域级同名项优先
# 例：官方 DeepSeek 直连（配好后 MODEL_MAIN_PRIMARY=deepseek-chat）
# MODEL_BASE_URL=https://api.deepseek.com/v1
# MODEL_API_KEY=sk-xxx
# 例：生图域单配一个端点（无鉴权时 KEY 留空，自动用占位 key）
# MODEL_IMAGE_API_BASE_URL=
# MODEL_IMAGE_API_API_KEY=
# 调用协议：缺省 chat（/chat/completions）；填 responses 走 OpenAI Responses API（/responses）
# MODEL_MAIN_API_TYPE=chat
# MODEL_MAIN_LIGHT_API_TYPE=chat
# MODEL_VISION_API_TYPE=chat
# MODEL_IMAGE_API_API_TYPE=chat
# 生图协议（仅 imageApi 域生效）：缺省 openai（/images/generations + /images/edits）；
# 填 si-image 走 TokenHub / 混元私有端点 /wand/si-image/generation（参考图 base64，最多 10 张）
# MODEL_IMAGE_API_IMAGE_PROTOCOL=openai

# ===== 降级机制参数（冷却时长 / 连通性探测超时）=====
# MODEL_HEALTH_TIMEOUT_MS=12000
# MODEL_FALLBACK_COOLDOWN_MS=60000
